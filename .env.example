# ==========================================
# 🛰️ Argus - Environment Configuration
# ==========================================
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# Server HTTP Address or Port
# Accepts ":8080", "0.0.0.0:8080" or simply PORT=8080
ARGUS_SERVER_ADDR=:8080
PORT=8080

# Interface & Diagnosis Language ("pt-BR" or "en")
ARGUS_LANG=pt-BR

# Optional Authentication (protects dashboard & API; leaves /status, /healthz, /metrics public)
# ARGUS_SERVER_AUTH_USERNAME=admin
# ARGUS_SERVER_AUTH_PASSWORD=change-me
# ARGUS_SERVER_AUTH_TOKEN=

# Path to the YAML configuration file
# Default is ./config.yaml (or ./config.example.yaml as fallback)
ARGUS_CONFIG_PATH=./config.yaml

# SQLite Storage & Retention
ARGUS_STORAGE_PATH=./data/argus.db
ARGUS_STORAGE_RETENTION_CHECKS=168h   # 7 days of detailed check logs
ARGUS_STORAGE_RETENTION_EVENTS=2160h  # 90 days of incident history & hourly rollups

# Global Check Defaults
ARGUS_DEFAULTS_INTERVAL=30s           # Interval between check cycles
ARGUS_DEFAULTS_HTTP_TIMEOUT=5s        # Timeout for HTTP requests
ARGUS_DEFAULTS_PING_TIMEOUT=3s        # Timeout for ICMP / TCP pings
ARGUS_DEFAULTS_FAIL_THRESHOLD=2       # Consecutive failures to trigger DOWN status
ARGUS_DEFAULTS_DEGRADED_LATENCY=2s    # Latency threshold to flag DEGRADED performance
ARGUS_DEFAULTS_TLS_WARN_DAYS=15       # Days before TLS expiration to flag DEGRADED

# Alerts & Notifications (optional — leave empty to disable)
ARGUS_ALERTS_COOLDOWN=5m
ARGUS_ALERTS_NOTIFY_ON_DEGRADED=false
# ARGUS_ALERTS_WEBHOOK_URL=https://hooks.example.com/argus
# ARGUS_ALERTS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# ARGUS_ALERTS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000/XXXX
# ARGUS_ALERTS_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# ARGUS_ALERTS_TELEGRAM_CHAT_ID=-1001234567890
# ARGUS_ALERTS_EMAIL_SMTP_HOST=smtp.example.com
# ARGUS_ALERTS_EMAIL_SMTP_PORT=587
# ARGUS_ALERTS_EMAIL_USERNAME=argus@example.com
# ARGUS_ALERTS_EMAIL_PASSWORD=secret
# ARGUS_ALERTS_EMAIL_FROM=argus@example.com
# ARGUS_ALERTS_EMAIL_TO=ops@example.com,sre@example.com
