# ==========================================
# 🛰️ Argus - Environment Configuration
# ==========================================
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# Server HTTP Address or Port
# Accepts ":8080", "0.0.0.0:8080" or simply PORT=8080
ARGUS_SERVER_ADDR=:8080
PORT=8080

# Path to the YAML configuration file
# Default is ./config.yaml (or ./config.example.yaml as fallback)
ARGUS_CONFIG_PATH=./config.yaml

# SQLite Storage & Retention
ARGUS_STORAGE_PATH=./data/argus.db
ARGUS_STORAGE_RETENTION_CHECKS=168h   # 7 days of detailed check logs
ARGUS_STORAGE_RETENTION_EVENTS=2160h  # 90 days of incident history

# Global Check Defaults
ARGUS_DEFAULTS_INTERVAL=30s           # Interval between check cycles
ARGUS_DEFAULTS_HTTP_TIMEOUT=5s        # Timeout for HTTP requests
ARGUS_DEFAULTS_PING_TIMEOUT=3s        # Timeout for ICMP / TCP pings
ARGUS_DEFAULTS_FAIL_THRESHOLD=2       # Consecutive failures to trigger DOWN status
ARGUS_DEFAULTS_DEGRADED_LATENCY=2s    # Latency threshold to flag DEGRADED performance
